# Copy this file to .env and fill in your own values.
# Get your App ID and Secret Key from the Cashfree dashboard (Sandbox mode
# for testing): https://merchant.cashfree.com/
CASHFREE_APP_ID=your_sandbox_app_id
CASHFREE_SECRET_KEY=your_sandbox_secret_key
# Optional: only needed if you use the Gemini insights feature.
GEMINI_API_KEY=your_gemini_api_key
# --- Mailing service (used by the forgot-password feature) ---
# Any SMTP provider works (Gmail, Brevo/Sendinblue, Mailtrap, etc).
# For Gmail: enable 2FA on the account, then create an "App Password"
# at https://myaccount.google.com/apppasswords and use that as SMTP_PASS
# (your normal Gmail password will NOT work here).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
# Base URL the reset-password link in the email points back to.
# Change this to your deployed URL in production.
APP_BASE_URL=http://localhost:3001
