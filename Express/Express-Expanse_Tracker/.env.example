# Copy this file to .env and fill in your own values. Never commit .env.

# --- Server ---
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# --- Database (MySQL) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=expanse_db
DB_USER=root
DB_PASSWORD=your_db_password

# --- Auth ---
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1d

# --- AWS S3 (premium report downloads) ---
# Use the Access Key ID / Secret Access Key of the IAM user you granted
# S3 full access to (IAM console -> Users -> your user -> Security
# credentials -> Create access key).
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_iam_access_key_id
AWS_SECRET_ACCESS_KEY=your_iam_secret_access_key
S3_BUCKET_NAME=your-bucket-name

# --- Cashfree (premium membership payments) ---
# Get your App ID and Secret Key from the Cashfree dashboard (Sandbox mode
# for testing): https://merchant.cashfree.com/
CASHFREE_APP_ID=your_sandbox_app_id
CASHFREE_SECRET_KEY=your_sandbox_secret_key

# Optional: only needed if you use the Gemini insights feature.
GEMINI_API_KEY=your_gemini_api_key

# --- Mailing service (used by the forgot-password feature) ---
# Any SMTP provider works (Gmail, Brevo/Sendinblue, Mailtrap, etc).
# For Gmail: enable 2FA on the account, then create an "App Password"
# at https://myaccount.google.com/apppasswords and use that as SMTP_PASS
# (your normal Gmail password will NOT work here).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Base URL the reset-password link in the email points back to.
# Change this to your deployed URL in production.
APP_BASE_URL=http://localhost:3001
