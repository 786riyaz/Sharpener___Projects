<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Attendance System</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <div class="container">
    <div class="topbar">
      <div class="date-group">
        <label for="datePicker"><strong>Select a Date:</strong></label>
        <input type="date" id="datePicker" />
        <button id="searchBtn" class="btn btn-blue">Search</button>
      </div>
      <button id="reportBtn" class="btn btn-green">Fetch Attendance report</button>
    </div>

    <div id="content" class="content">
      <p class="hint">Pick a date and click <strong>Search</strong> to view or mark attendance.</p>
    </div>
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/axios/1.7.7/axios.min.js"></script>
  <script src="/js/app.js"></script>
</body>
</html>
